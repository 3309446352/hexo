{
    "builds": [
        {
            "src": "vite.config.js",
            "use": "@vercel/static-build",
            "config": {
                "outputDirectory": "source"
            }
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "headers": {
                "Cache-Control": "public, max-age=31536000, immutable"
            }
        },
        {
            "src": "/bli/(.*)",
            "dest": "https://api.bilibili.com/x/space/bangumi/follow/list?$1",
            "headers": {
                "Access-Control-Allow-Origin": "*",
                "Origin": "https://api.bilibili.com",
                "Referer": "https://api.bilibili.com",
                "User-Agent": "HCLonely/hexo-bilibili-bangumi"
            }
        },
        {
            "src": "/ImageUrl",
            "dest": "https://www.dmoe.cc/random.php"
        },
        {
            "src": "/ip",
            "dest": "https://m.ipplus360.com/$1"
        },
        {
            "src": "/Address",
            "dest": "https://www.ipplus360.com/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html",
            "headers": {
                "Content-Type": "text/html"
            }
        }
    ],
    "headers": [
        {
            "source": "/(.*)\\.js",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/javascript"
                }
            ]
        }
    ]
}