{
    "builds": [
        {
            "src": "vite.config.js",
            "use": "@vercel/static-build",
            "config": {
                "outputDirectory": "source"
            }
        }
    ],
    "rewrites": [
        {
            "source": "/static/(.*)",
            "destination": "/static/$1"
        },

        // API 代理路由
        {
            "source": "/bli/(.*)",
            "destination": "https://api.bilibili.com/x/space/bangumi/follow/list?$1",
            "headers": {
                "Access-Control-Allow-Origin": "*",
                "Origin": "https://api.bilibili.com",
                "Referer": "https://api.bilibili.com",
                "User-Agent": "HCLonely/hexo-bilibili-bangumi"
            }
        },
        {
            "source": "/ImageUrl",
            "destination": "https://www.dmoe.cc/random.php"
        },


        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/static/js/(.*)\\.js",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/javascript"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },

        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "text/html"
                }
            ]
        }
    ]
}